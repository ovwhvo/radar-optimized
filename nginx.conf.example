# ----------------------------------------------------------------------
# 政策补贴雷达 · 优化后的 nginx 参考配置（随优化版一并交付）
#
# 针对逆向发现的三类问题：
#   1) 重复响应头 —— 原站 X-Content-Type-Options / Referrer-Policy 各出现两次，
#      根因是同一组 add_header 在两个配置层级（如 http/server 与 location）各写了一遍。
#      nginx 的 add_header 不向上合并：location 里只要出现一条 add_header，
#      上层同名头就不继承；反之两层都写就会重复下发。修法是"只在一处定义"。
#   2) 静态 JS 未压缩 —— gzip_types 默认只有 text/html，必须显式包含 JS。
#   3) 无缓存验证器 + no-cache —— 保证静态资源有 ETag，并给哈希资源长缓存。
# ----------------------------------------------------------------------

server {
    listen 443 ssl http2;
    server_name radar.huixiang17.cn;

    ssl_certificate     /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;

    server_tokens off;                 # 不暴露 nginx 版本号
    etag on;                           # 静态与代理响应保留 ETag（配合 no-cache 回源验证）
    root /srv/radar/dist;

    # ---------- 压缩（原站 JS 未压缩的直接修复） ----------
    gzip on;
    gzip_vary on;                      # 缓存链路区分 Accept-Encoding
    gzip_static on;                    # 直接发 build.py 产出的 .gz 预压缩副本
    gzip_min_length 1024;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml text/javascript
               application/javascript application/json application/xml
               image/svg+xml;

    # ---------- 安全响应头：全部集中在这一层，只写一次 ----------
    # HSTS：确认 HTTPS 全站可用后再打开
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    # CSP 收紧：原站 style-src 全局 'unsafe-inline'；
    # 页面确有 style="width:…" 属性与 CSSOM 写入，故仅对属性级放行，
    # style-src 本身保持 'self'，阻止注入 <style> 标签。
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" always;

    # ---------- 缓存策略 ----------
    # 带内容哈希的产物：一年强缓存，内容变了文件名就变
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri $uri.gz =404;
    }

    # HTML 与 API：no-cache 表示"每次回源验证"，有 ETag 才能 304
    location / {
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri.gz =404;
    }

    location /api/v1/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 上游若也下发安全头，这里用 proxy_hide_header 统一为本层的一份
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;
    }

    location /data/ {
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri.gz =404;
    }
}
